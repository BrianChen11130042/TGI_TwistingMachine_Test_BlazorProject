@using CommonRazorLibraryB.UIComponentTools.ToastMessage
@inherits DrawerStateLayoutComponentBase

<DxGridLayout CssClass="p-3">
    <Rows>
        <DxGridLayoutRow Height="auto"></DxGridLayoutRow>
        <DxGridLayoutRow Height="1fr"></DxGridLayoutRow>
    </Rows>
    <Columns>
        <DxGridLayoutColumn></DxGridLayoutColumn>
    </Columns>
    <Items>
        <DxGridLayoutItem Row="0" Column="0">
            <Template>
                <NavMenu />
            </Template>
        </DxGridLayoutItem>
        <DxGridLayoutItem Row="1" Column="0">
            <Template>
                <div class="page-body">
                    @Body
                </div>
            </Template>
        </DxGridLayoutItem>
    </Items>
</DxGridLayout>

<ToastMessageProvider />

