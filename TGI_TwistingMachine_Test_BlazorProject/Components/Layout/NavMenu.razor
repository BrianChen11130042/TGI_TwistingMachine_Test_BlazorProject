@using DevExpress.Images.Blazor
@using TGI_TwistingMachine_Test_BlazorProject.EquipName.TwistingMachine
@implements IDisposable

<div class="card p-2">
    <DxMenu Orientation="@Orientation.Horizontal" CssClass="menu" ItemsPosition="ItemPosition.Center">
        <Items>
            <DxMenuItem NavigateUrl="/" Text="Home" IconUrl="@IconStatic.Home.Fluent.Regular.Monochrome.Size32"></DxMenuItem>

            <DxMenuItem Text="Mission" IconUrl="@IconStatic.WorkflowStart.DesktopClassic.Regular.Monochrome.Size32">
                <Items>
                    @foreach (ETwist twist in Enum.GetValues(typeof(ETwist)))
                    {
                        <DxMenuItem NavigateUrl="@($"/TwistMission/{twist}")" Text="@twist.ToString()" />
                    }
                </Items>
            </DxMenuItem>
            
            <DxMenuItem Text="Setting" IconUrl="@IconStatic.SettingsGear.Fluent.Regular.Monochrome.Size48">
                <Items>
                    <DxMenuItem NavigateUrl="/TwistTableConfig" Text="Twist Table" />
                    <DxMenuItem NavigateUrl="/ConnectConfig" Text="Connection" />
                </Items>
            </DxMenuItem>
        </Items>
    </DxMenu>
</div>

<br/>

@code {
    protected override async Task OnInitializedAsync()
    {
        //await base.OnInitializedAsync();
    }

    public void Dispose() {
        
    }
}
